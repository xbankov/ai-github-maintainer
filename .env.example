# AI GitHub Maintainer — environment. Copy to .env (chmod 600). Never commit .env.
# All secrets live here and nowhere else.

# --- Paths -------------------------------------------------------------------
# Host directory for the database (db/) and repository clones/worktrees (workspaces/).
# Must be on the root disk and owned by uid 1000.
DATA_DIR=/home/ubuntu/ai-maintainer-data

# --- HTTP --------------------------------------------------------------------
# Host port (bound to 127.0.0.1 only).
HTTP_PORT=8787
LOG_LEVEL=info

# --- GitHub App ----------------------------------------------------------------
# App ID from the App's settings page.
GITHUB_APP_ID=
# The App's private key, on ONE line with literal \n between lines:
#   GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
# Convert a downloaded .pem with:  awk '{printf "%s\\n", $0}' key.pem   (then delete the .pem)
GITHUB_APP_PRIVATE_KEY=
# Webhook secret (Milestone 2). Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# --- OpenCode server -----------------------------------------------------------
# Basic-auth credentials of the existing OpenCode server (see `opencode service get`).
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# --- Safety --------------------------------------------------------------------
# Global kill switch: true = start nothing. Can also be toggled at runtime:
#   docker compose exec maintainer node dist/cli.js pause "reason" | resume | status
MAINTAINER_PAUSED=false
